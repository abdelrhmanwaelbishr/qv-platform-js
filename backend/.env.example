# Neon: use the pooled connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/qawim?sslmode=require&pgbouncer=true"
# Neon: use the direct (non-pooled) connection string for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/qawim?sslmode=require"

SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
PORT=8000
HOST=127.0.0.1
