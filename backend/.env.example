# Neon: pooled connection string (host contains "-pooler") for the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: direct (non-pooled) connection string for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Auth (written by `neon deploy` into .env.local; copy here for the backend)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Better Auth (self-managed login, see src/auth/auth.ts)
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
BETTER_AUTH_URL=http://127.0.0.1:8000

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
HOST=127.0.0.1
